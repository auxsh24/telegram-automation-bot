# Telegram Relay Dashboard — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ==========================================
# REQUIRED — Dashboard Authentication
# ==========================================
RELAY_USERNAME=operator
RELAY_PASSWORD=change-me-to-a-long-random-string

# ==========================================
# REQUIRED — Telegram API (my.telegram.org)
# ==========================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_32_char_api_hash_here

# ==========================================
# OPTIONAL — Database (default: SQLite)
# ==========================================
# Leave empty for SQLite (local dev / single container).
# Set to PostgreSQL URL for cloud deployment:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ==========================================
# OPTIONAL — Telegram Session String
# ==========================================
# Generate locally once: python -c "from telethon.sync import TelegramClient; ..."
# In cloud, set this so the session survives container restarts.
# If empty, the app uses the session file (data/telegram_session).
TELEGRAM_SESSION_STRING=

# ==========================================
# OPTIONAL — Relay Settings (defaults shown)
# ==========================================
RELAY_CONVERTER_BOT=@ExtraPeBot
RELAY_SOURCE_CHANNELS=[]
RELAY_DUPLICATE_TTL_DAYS=1
RELAY_RETRY_ATTEMPTS=3
RELAY_RETRY_DELAY_SECONDS=2
RELAY_LOG_RETENTION_DAYS=1

# ==========================================
# OPTIONAL — Security / Rate Limiting
# ==========================================
# RELAY_MAX_ATTEMPTS=8
# RELAY_RATE_WINDOW=300
# RELAY_LOCKOUT_SECONDS=900
# RELAY_AUTH_DISABLED=false

# ==========================================
# OPTIONAL — Data Directory
# ==========================================
# RELAY_DATA_DIR=/app/data
